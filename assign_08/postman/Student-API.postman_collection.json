{
  "info": {
    "name": "VSEC Student API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run sequentially against your local API. Creates and deletes its own student."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "studentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Create student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/students",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Student\",\n  \"rollNumber\": \"PM-{{$timestamp}}\",\n  \"department\": \"IT\",\n  \"marks\": 80\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('studentId',pm.response.json()._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 List students",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/students"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Array response',()=>pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Read student",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/students/{{studentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Correct student',()=>pm.expect(pm.response.json()._id).to.eql(pm.collectionVariables.get('studentId')));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Update marks",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/students/{{studentId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"marks\": 95\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Marks updated',()=>pm.expect(pm.response.json().marks).to.eql(95));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Invalid marks",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/students/{{studentId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"marks\": 101\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Invalid ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/students/not-an-id"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Delete student",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/students/{{studentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Verify deletion",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/students/{{studentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
